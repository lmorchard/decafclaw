[Unit]
Description=DecafClaw AI Agent
After=network-online.target
Wants=network-online.target
# A broken deploy must land in `failed`, not crash-loop forever at 5s.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=%h/decafclaw
ExecStart=%h/.local/bin/uv run --extra memory decafclaw
Restart=always
RestartSec=5
# Stop gracefully (SIGTERM), then force after 15s
TimeoutStopSec=15

# Environment
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/decafclaw/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=decafclaw

[Install]
WantedBy=default.target
