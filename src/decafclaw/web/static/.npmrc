# Fail the install on an unsupported Node rather than warning past it.
#
# Without this, an old Node installs "successfully" and then fails much later
# with something unrecognizable — Node 20.9 got a bare
# `SyntaxError: 'node:util' does not provide an export named 'styleText'`
# out of vitest's rolldown dependency, which reads as a broken repo rather
# than a broken toolchain. The engines range in package.json mirrors what our
# transitive deps already declare; this makes npm enforce it up front.
engine-strict=true
